 "npcs": [
  {
   "id": "guide-pingan",
   "name": "摄影师阿鹏",
   "landmark": "pingan",
   "dialogue": [
    {
     "id": "greet",
     "text": "欢迎来到方块鹏城！我是摄影师阿鹏。举起相机（C 键），把这座城市的美拍进你的图鉴吧。",
     "choices": [
      {
       "text": "拍照能赚多少钱？",
       "next": "money"
      },
      {
       "text": "这里有什么好拍的？",
       "next": "spots"
      }
     ]
    },
    {
     "id": "money",
     "text": "首次拍摄一个地标 +¥50，重复拍摄 +¥5。拍满 25 个地标还能解锁「湾区行者」飞升阶段！",
     "choices": [
      {
       "text": "明白了，谢谢！"
      }
     ]
    },
    {
     "id": "spots",
     "text": "平安金融中心是深圳第一高楼；莲花山顶能拍市民中心全景；大梅沙的日落千万别错过。",
     "choices": [
      {
       "text": "谢谢指点！"
      }
     ]
    }
   ],
   "enabled": true
  },
  {
   "id": "guide-civic",
   "name": "义工姐姐",
   "landmark": "civic",
   "dialogue": [
    {
     "id": "greet",
     "text": "你好呀！需要帮助吗？深圳是一座志愿者之城，我就是千万\"红马甲\"之一。",
     "choices": [
      {
       "text": "怎么快速去别的区？",
       "next": "metro"
      },
      {
       "text": "没什么，路过打个招呼",
       "next": "bye"
      }
     ]
    },
    {
     "id": "metro",
     "text": "地铁站里按 E 键就能乘车，跨区一瞬间就到。攒够能量后还能解锁传送（T 键）更快！",
     "choices": [
      {
       "text": "太方便了，谢谢！"
      }
     ]
    },
    {
     "id": "bye",
     "text": "祝你玩得开心！对了对了，东门老街的小吃街值得一逛。",
     "choices": [
      {
       "text": "好的，回见！"
      }
     ]
    }
   ],
   "enabled": true
  },
  {
   "id": "merchant-dongmen",
   "name": "小摊老板陈叔",
   "landmark": "dongmen",
   "shopGreet": "陈叔的东门小摊 · 现做现卖",
   "shopItems": [
    {
     "id": "food_cheong_fun",
     "name": "肠粉",
     "price": 15
    },
    {
     "id": "food_wonton",
     "name": "云吞面",
     "price": 18
    },
    {
     "id": "food_herbal_tea",
     "name": "凉茶",
     "price": 10
    },
    {
     "id": "food_char_siu",
     "name": "叉烧",
     "price": 22
    }
   ],
   "dialogue": [
    {
     "id": "greet",
     "text": "靓仔来啦！尝尝陈叔的手打柠檬茶？刚从东门进的货。",
     "choices": [
      {
       "text": "来一杯！（免费的吗？）",
       "next": "free",
       "give": {
        "money": 20
       }
      },
      {
       "text": "下次吧，赶时间",
       "next": "bye"
      }
     ]
    },
    {
     "id": "free",
     "text": "第一次见面算我请客！这 ¥20 拿着，去隔壁老街买些吃的。常来啊！",
     "choices": [
      {
       "text": "谢谢陈叔！"
      }
     ]
    },
    {
     "id": "bye",
     "text": "行嘞，路过别忘了我这口甜！",
     "choices": [
      {
       "text": "一定！"
      }
     ]
    }
   ],
   "enabled": true
  },
  {
   "id": "guide-seaworld",
   "name": "设计师小湾",
   "landmark": "szbay",
   "dialogue": [
    {
     "id": "greet",
     "text": "嘿，你也是来看春笋的吗？我是建筑设计师小湾，深圳湾天际线就是我的灵感来源。",
     "choices": [
      {
       "text": "深圳为什么有这么多高楼？",
       "next": "tall"
      },
      {
       "text": "你是怎么成为设计师的？",
       "next": "story"
      }
     ]
    },
    {
     "id": "tall",
     "text": "深圳从边陲小镇到国际都市只用了四十年，每一栋楼都是向上生长的梦想。拍下它们吧！",
     "choices": [
      {
       "text": "受教了！"
      }
     ]
    },
    {
     "id": "story",
     "text": "小时候在莲花山看市民中心，就觉得\"哇，这就是未来\"。现在我把未来画在图纸上。",
     "choices": [
      {
       "text": "很浪漫的故事",
       "next": "g2"
      }
     ]
    },
    {
     "id": "g2",
     "text": "对了，解锁「城市建造者」阶段后你也能亲手搭建自己的建筑（B 键）！",
     "choices": [
      {
       "text": "好期待！"
      }
     ]
    }
   ],
   "enabled": true
  },
  {
   "id": "guide-dameisha",
   "name": "冲浪少年阿浪",
   "landmark": "dameisha",
   "dialogue": [
    {
     "id": "greet",
     "text": "哟！海边来的？今天的浪不错。我叫阿浪，大梅沙土著，浪龄十年。",
     "choices": [
      {
       "text": "海边有什么好玩的？",
       "next": "fun"
      },
      {
       "text": "你晒得好黑",
       "next": "tan"
      }
     ]
    },
    {
     "id": "fun",
     "text": "冲浪、看日落、吃窑鸡！要是乘游船出海，还能从海上拍深圳最美的天际线。",
     "choices": [
      {
       "text": "听心动了！"
      }
     ]
    },
    {
     "id": "tan",
     "text": "哈哈这是勋章！盐田的太阳最实在，晒一小时顶市区一天。",
     "choices": [
      {
       "text": "哈哈，保重皮肤！"
      }
     ]
    }
   ],
   "enabled": true
  },
  {
   "id": "elder-dapeng",
   "name": "所城老伯",
   "landmark": "dapeng",
   "dialogue": [
    {
     "id": "greet",
     "text": "后生仔，你脚踩的可是明朝的抗倭古城。大鹏所城，六百年了。",
     "choices": [
      {
       "text": "这里有什么历史？",
       "next": "hist"
      },
      {
       "text": "老伯您多大年纪了？",
       "next": "age"
      }
     ]
    },
    {
     "id": "hist",
     "text": "赖恩爵将军就在这儿打的九龙海战，深圳的故事不只四十年，是六百年！",
     "choices": [
      {
       "text": "肃然起敬",
       "next": "g2"
      }
     ]
    },
    {
     "id": "age",
     "text": "哈哈哈，比你爷爷还大些。来，压岁钱拿去，添个彩头。",
     "choices": [
      {
       "text": "谢谢老伯！",
       "next": "g2",
       "give": {
        "money": 50
       }
      }
     ]
    },
    {
     "id": "g2",
     "text": "城里的将军府、粮仓都值得一逛。走累了吧？传送点就在附近。",
     "choices": [
      {
       "text": "谢谢您嘞！"
      }
     ]
    }
   ],
   "enabled": true
  }
 ],
